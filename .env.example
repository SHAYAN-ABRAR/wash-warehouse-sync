# Optional environment variables for the local engine (no secrets are needed).
# Copy to .env only if your launcher loads it; the engine itself reads the process environment.

# Private state directory: versions, plans, audits, manifest, fingerprints, crosswalk, index.
# Keep it on an encrypted / access-controlled disk. Never inside a public repository.
WASH_SYNC_HOME=~/.wash_sync

# Name recorded as the actor of CLI operations (the web UI sends the reviewer name instead).
WASH_SYNC_ACTOR=

# Serve a custom web build instead of apps/web/dist-local.
WASH_SYNC_WEB_DIST=
